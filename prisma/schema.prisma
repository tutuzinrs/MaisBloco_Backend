generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum LocationSharingLevel {
  PRIVATE
  FRIENDS
  GROUP
  PUBLIC
}

enum MessageReactionType {
  LIKE
  LOVE
  FIRE
  PARTY
  CLAP
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  nickname     String?
  username     String    @unique
  email        String    @unique
  passwordHash String?
  cpf          String?   @unique
  phone        String?   @unique
  birthDate    DateTime?

  // 1 = ADMIN, 2 = CLIENTE
  role    Int      @default(2)
  avatar  String?
  city    String?

  status         UserStatus   @default(ACTIVE)
  authProvider   AuthProvider @default(LOCAL)
  authProviderId String?

  failedLoginAttempts Int       @default(0)
  blockedUntil        DateTime?
  lastLoginAt         DateTime?

  locationSharingLevel LocationSharingLevel @default(PRIVATE)
  notificationPreferences NotificationPreferences?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  friendshipsRequested Friendship[]              @relation("Requester")
  friendshipsReceived  Friendship[]              @relation("Receiver")
  groupMemberships     GroupMember[]
  ownedGroups          Group[]                   @relation("GroupOwner")
  groupInvitesSent     GroupInvite[]             @relation("GroupInviteInviter")
  groupInvitesReceived GroupInvite[]             @relation("GroupInviteInvitee")
  sentMessages         Message[]                 @relation("MessageSender")
  eventParticipants    EventParticipant[]
  location             Location?
  pushDevices          PushDevice[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  blockedUsers         Block[]                   @relation("Blocker")
  blockedByUsers       Block[]                   @relation("Blocked")
  reports              Report[]                  @relation("Reporter")
  reportedByUsers      Report[]                  @relation("Reported")
  meetingPointCreated  MeetingPoint[]
  meetingPointShared   MeetingPointShare[]
  reactions            MessageReaction[]
  pinnedMessages       PinnedMessage[]
  favorites            Favorite[]
  conversations        ConversationParticipant[]

  @@index([cpf])
  @@index([phone])
  @@index([role])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Group {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  avatar      String?
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  invites GroupInvite[]
  chat    GroupChat?

  @@index([ownerId])
}

model GroupMember {
  id       Int             @id @default(autoincrement())
  groupId  Int
  userId   Int
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupInvite {
  id        Int               @id @default(autoincrement())
  groupId   Int
  inviterId Int
  inviteeId Int
  status    GroupInviteStatus @default(PENDING)
  expiresAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("GroupInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User  @relation("GroupInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId, status])
  @@index([inviteeId, status])
  @@index([groupId])
  @@index([inviterId])
}

model GroupChat {
  id        Int      @id @default(autoincrement())
  groupId   Int      @unique
  createdAt DateTime @default(now())

  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages       Message[]
  pinnedMessages PinnedMessage[]

  @@index([groupId])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([id])
}

model ConversationParticipant {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  content        String?
  imageUrl       String?
  locationShare  Json?
  conversationId Int?
  groupChatId    Int?
  senderId       Int
  replyToId      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  groupChat    GroupChat?        @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("ReplyTo")
  reactions    MessageReaction[]
  pinnedBy     PinnedMessage[]

  @@index([conversationId])
  @@index([groupChatId])
  @@index([senderId])
}

model MessageReaction {
  id        Int                 @id @default(autoincrement())
  messageId Int
  userId    Int
  type      MessageReactionType
  createdAt DateTime            @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
  @@index([messageId])
}

model PinnedMessage {
  id          Int      @id @default(autoincrement())
  messageId   Int
  userId      Int
  groupChatId Int
  createdAt   DateTime @default(now())

  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupChat GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)

  @@unique([messageId, groupChatId])
}

model Event {
  id              Int         @id @default(autoincrement())
  name            String
  description     String?
  coverImage      String?
  latitude        Float
  longitude       Float
  address         String?
  startAt         DateTime
  endAt           DateTime?
  category        String?
  status          EventStatus @default(UPCOMING)
  estimatedPeople Int?
  externalLink    String?
  isPaid          Boolean     @default(false)
  price           Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participants  EventParticipant[]
  favorites     Favorite[]
  meetingPoints MeetingPoint[]

  @@index([startAt])
  @@index([latitude, longitude])
}

model EventParticipant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Favorite {
  id      Int @id @default(autoincrement())
  userId  Int
  eventId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Location {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
}

model MeetingPoint {
  id          Int       @id @default(autoincrement())
  eventId     Int?
  title       String
  description String?
  latitude    Float
  longitude   Float
  validUntil  DateTime?
  createdById Int
  createdAt   DateTime  @default(now())

  event   Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  creator User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  shared  MeetingPointShare[]

  @@index([eventId])
  @@index([latitude, longitude])
}

model MeetingPointShare {
  id             Int      @id @default(autoincrement())
  meetingPointId Int
  sharedWithId   Int
  createdAt      DateTime @default(now())

  meetingPoint MeetingPoint @relation(fields: [meetingPointId], references: [id], onDelete: Cascade)
  sharedWith   User         @relation(fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([meetingPointId, sharedWithId])
}

model Report {
  id          Int      @id @default(autoincrement())
  reporterId  Int
  reportedId  Int?
  messageId   String?
  reason      String
  description String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  reporter User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User? @relation("Reported", fields: [reportedId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([resolved])
}

model Notification {
  pushDeliveries PushDelivery[]
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model NotificationPreferences {
  userId Int @id
  friendRequests Boolean @default(true)
  groupInvites Boolean @default(true)
  messages Boolean @default(true)
  groupActivity Boolean @default(true)
  favoriteEvents Boolean @default(true)
  eventReminders Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PushDeliveryStatus {
  PENDING
  RECEIPT
  DONE
  FAILED
  CANCELLED
}

model PushDevice {
  id String @id @db.Uuid
  userId Int
  token String @unique
  platform String
  secretHash String
  version Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId, active])
}

model PushDelivery {
  id Int @id @default(autoincrement())
  notificationId Int
  deviceId String @db.Uuid
  token String
  deviceVersion Int
  status PushDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  receiptAttempts Int @default(0)
  ticketId String?
  lastError String?
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  claimId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
}
