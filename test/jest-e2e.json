{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ES2022",
          "moduleResolution": "bundler"
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "setupFiles": [
    "<rootDir>/setup-e2e.cjs"
  ]
}
