# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goBloco?schema=public"

# Auth
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="15m"

# App
PORT=3000

# Deep link scheme used to build the password reset link (Expo scheme)
APP_SCHEME="goBloco"

# Resend (transactional e-mail) for password recovery.
# Create a free account at https://resend.com, copy your API key and a verified
# sender (domain or onboarding@resend.dev for testing).
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Go Bloco <onboarding@resend.dev>"

# CORS origins (comma separated). Defaults to allowing all origins when unset.
# CORS_ORIGINS="http://localhost:8081"

# Codante (agenda de blocos) — consumida somente pelo backend.
# Quantas páginas (10 eventos/página) buscar da API externa.
# CODANTE_MAX_PAGES=30
# Tempo de cache da agenda externa em milissegundos.
# CODANTE_CACHE_TTL_MS=600000
# Timeout das chamadas à API externa em milissegundos.
# CODANTE_TIMEOUT_MS=8000
# Expo Push Service: habilitar apenas depois de aplicar as migrações e configurar credenciais.
PUSH_ENABLED=false
# Token privado do Expo quando a segurança adicional estiver habilitada. Nunca expor no app.
EXPO_ACCESS_TOKEN=
# Testes E2E exigem banco isolado, sem dados reais.
# TEST_DATABASE_URL=postgresql://.../gobloco_test
