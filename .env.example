# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maisbloco?schema=public"

# Auth
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="15m"

# App
PORT=3000

# Deep link scheme used to build the password reset link (Expo scheme)
APP_SCHEME="maisbloco"

# Optional SMTP configuration for transactional e-mails.
# When unset, reset links are logged to the console instead of being delivered.
# SMTP_URL="smtps://user:pass@smtp.example.com"

# CORS origins (comma separated). Defaults to allowing all origins when unset.
# CORS_ORIGINS="http://localhost:8081"